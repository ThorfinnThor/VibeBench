# Optional, temporary owner-only access to real protected scan reports.
# Use a unique random value with at least 24 characters. Never commit the real key.
VIBEFOOTPRINT_ADMIN_PREVIEW_KEY=
VIBEFOOTPRINT_ADMIN_UI=false

# Customer launch default: Stripe payment required for the detailed scan.
# Set explicitly to free-test only in a controlled internal test environment.
VIBEFOOTPRINT_REPORT_MODE=commercial

# Server-only Stripe secret used for hosted Checkout and payment verification.
# Do not prefix this variable with NEXT_PUBLIC_ and never commit the real key.
STRIPE_SECRET_KEY=

# Public canonical origin used by metadata, sitemap and structured data.
# Replace this with the final production domain before launch.
NEXT_PUBLIC_SITE_URL=https://www.vibefootprint.com

# Optional token shown in Google Search Console when using the HTML-tag method.
# Paste only the content value, not the complete meta tag.
GOOGLE_SITE_VERIFICATION=
